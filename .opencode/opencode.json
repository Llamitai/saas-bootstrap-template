{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "codegraph": {
      "type": "local",
      "command": ["codegraph", "serve", "--mcp"],
      "enabled": true
    },
    "shadcn": {
      "type": "local",
      "command": ["./node_modules/.bin/shadcn", "mcp"],
      "cwd": "frontend",
      "enabled": true
    },
    "chrome-devtools": {
      "type": "local",
      "command": ["npx", "-y", "chrome-devtools-mcp@latest"],
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp@latest"],
      "enabled": true
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true,
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      }
    },
    "tailwindcss-server": {
      "type": "local",
      "command": ["./node_modules/.bin/tailwindcss-mcp"],
      "cwd": "frontend",
      "enabled": true,
      "environment": {
        "TAILWIND_VERSION": "4"
      }
    }
  },
  "skills": {
    "paths": [".opencode/skills"]
  },
  "instructions": [
    "AGENTS.md",
    "frontend/CLAUDE.md",
    "docs/internal/architecture/frontend-architecture.md"
  ],
  "lsp": {
    "pyright": {
      "command": ["pyright-langserver", "--stdio"],
      "extensions": [".py", ".pyi"]
    },
    "typescript": {
      "command": ["typescript-language-server", "--stdio"],
      "extensions": [".ts", ".tsx", ".js", ".jsx", ".mjs", ".cjs", ".mts", ".cts"]
    }
  }
}
