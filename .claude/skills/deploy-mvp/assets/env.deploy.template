# Operator inputs for the first production deploy.
#
#   cp <skill-dir>/assets/env.deploy.template .env.deploy
#
# This file holds live credentials. It must never be committed.
# Confirm `.env.deploy` is matched by .gitignore before filling it in:
#
#   git check-ignore -v .env.deploy
#
# Nothing here is stored in Infisical, Portainer, or GitHub. It is read by the
# deploy-mvp scripts on your machine only.

# ─── Project identity ───────────────────────────────────────────────
# Lowercase, alphanumeric + hyphens. Used to derive the Postgres role and
# database, the GHCR image names, and the Portainer stack names.
PROJECT_SLUG=

# owner/repo on GitHub, e.g. acme-inc/acme-app
GITHUB_REPOSITORY=

# Public origins the deployed app will serve on.
PUBLIC_APP_URL=https://app.example.com
PUBLIC_API_URL=https://api.example.com

# ─── PostgreSQL superuser ───────────────────────────────────────────
# Used only during phase 1 to create the project role and databases.
# Never written anywhere; not needed after provisioning.
PGHOST=
PGPORT=5432
PGUSER=postgres
PGPASSWORD=
# Database to connect to while creating the new ones (must already exist).
PGDATABASE=postgres
# Optional: require TLS to the Postgres server. Recommended for remote servers.
PGSSLMODE=prefer

# Host:port the *containers* use to reach Postgres. Often differs from PGHOST
# (which is how *you* reach it). If Postgres runs on the Docker host, this is
# usually the host's LAN address or a service name on shared-network.
APP_POSTGRES_HOST=
APP_POSTGRES_PORT=5432

# ─── Infisical ──────────────────────────────────────────────────────
# Self-hosted base URL (no trailing slash), or https://app.infisical.com
INFISICAL_API_URL=
# Machine identity with universal auth, granted access to both projects.
INFISICAL_MACHINE_CLIENT_ID=
INFISICAL_MACHINE_CLIENT_SECRET=
# Environment slug to seed. Match what the stack passes as INFISICAL_SECRET_ENV.
INFISICAL_SECRET_ENV=prod
# Project ids. Leave blank to have the skill create the projects and fill these in.
BACKEND_PROJECT_ID=
FRONTEND_PROJECT_ID=

# ─── Portainer ──────────────────────────────────────────────────────
# Base URL of the Portainer instance (no trailing slash, no /api suffix).
PORTAINER_URL=
# API access token from User settings -> Access tokens.
PORTAINER_TOKEN=
# Environment (endpoint) id to deploy into. `preflight.py` lists the options.
PORTAINER_ENDPOINT_ID=
# Set to 1 if the GitHub repository is private (Portainer then needs to
# authenticate to clone it; supply a PAT with `repo` scope below).
PORTAINER_REPO_PRIVATE=0
GITHUB_CLONE_USERNAME=
GITHUB_CLONE_TOKEN=

# ─── Directus admin console (backend stack only) ────────────────────
# Directus needs its own database, separate from the application database.
# Leave ADMIN_DB_* blank to have phase 1 provision and fill them in.
ADMIN_EMAIL=
ADMIN_DB_HOST=
ADMIN_DB_DATABASE=
ADMIN_DB_USER=
ADMIN_PUBLIC_URL=
# Generated by phase 1 / phase 2 if left blank:
ADMIN_SECRET=
ADMIN_PASSWORD=
ADMIN_DB_PASSWORD=
