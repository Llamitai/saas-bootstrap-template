# Backend — FastAPI (port 8200). Run: just backend <command>

set dotenv-load := false
set working-directory := "../backend"

# List backend commands
default:
    @just --list backend

# ─── RUN ────────────────────────────────────────────────────────

# Create backend/.env from .env.example on first run (docker compose requires it)
_ensure-env:
    @[ -f .env ] || { cp .env.example .env && echo "created backend/.env from .env.example"; }

# Start the full stack (API + Postgres + Redis + Directus + MinIO + Mailpit)
dev: _ensure-env
    docker compose up

# Start the full stack detached
dev-d: _ensure-env
    docker compose up -d

# Run the API locally without docker (needs postgres/redis up)
dev-local:
    uvicorn config.main:app --host 0.0.0.0 --port 8200 --reload

# Open a bash shell in the api container
bash:
    docker compose run --rm api bash

# Run the api with its service ports exposed (for attaching a debugger)
debug:
    docker compose run --service-ports api

# Start the stack with debugpy attached (docker-compose.debug.yml)
debugpy:
    docker compose -f docker-compose.yml -f docker-compose.debug.yml up

# Build the backend images
build:
    docker compose build

# Stop the backend stack
stop:
    docker compose down

# Tail the api logs
logs:
    docker compose logs -f api

# ─── PRODUCTION ─────────────────────────────────────────────────

# Build the production backend image
build-prod:
    docker compose -f docker-compose.prod.yml build

# Start the production backend (detached)
up-prod:
    docker compose -f docker-compose.prod.yml up -d

# ─── TESTS ──────────────────────────────────────────────────────

# Run tests. marker: unit (default) | single | api | all; extra pytest args follow.
# `api` and `all` bring the stack up, wait for :8200, run, then tear it down.
#   just backend test                 # unit (excludes api)
#   just backend test unit tests/tenants
test marker="unit" *args="": _ensure-env
    #!/usr/bin/env bash
    set -euo pipefail
    case "{{marker}}" in
      unit)   docker compose run --rm api bash -c "pytest --pyargs -m 'not api' {{args}}" ;;
      single) docker compose run --rm api bash -c "pytest --pyargs -m single {{args}}" ;;
      api|all)
          cleanup_api_stack() {
              docker compose down
          }
          trap cleanup_api_stack EXIT
          docker compose up -d
          echo "⏳ Waiting for API on :8200..."
          for attempt in $(seq 1 120); do
              if curl -sf http://localhost:8200 >/dev/null 2>&1; then break; fi
              if [ "${attempt}" -eq 120 ]; then
                  echo "❌ API did not become ready on :8200 after 120s" >&2
                  exit 1
              fi
              sleep 1
          done
          echo "✅ API ready"
          if [ "{{marker}}" = "api" ]; then
              docker compose run --rm api bash -c "pytest -m api --pyargs {{args}}"
          else
              docker compose run --rm api bash -c "pytest --pyargs {{args}}"
          fi ;;
      *) echo "Unknown marker '{{marker}}'. Use: unit | single | api | all" >&2; exit 1 ;;
    esac

# ─── CODE QUALITY ───────────────────────────────────────────────

# Format with ruff
format: _ensure-env
    docker compose run --rm api ruff format .

# Lint with ruff (autofix)
lint: _ensure-env
    docker compose run --rm api ruff check . --fix

# Type-check with ty
typecheck: _ensure-env
    docker compose run --rm api uv run ty check

# Report unused code with vulture
unused:
    docker compose run --rm api vulture src tests

# Enforce Clean Architecture layer boundaries with import-linter
lint-imports: _ensure-env
    docker compose run --rm api uv run lint-imports

# Run format + lint + typecheck + architecture boundaries
quality: format lint typecheck lint-imports

# ─── DATABASE / MIGRATIONS ──────────────────────────────────────

# Apply all pending migrations
migrate: _ensure-env
    docker compose run --rm api alembic upgrade head

# Create a new autogenerated migration: just backend new-migration "add users table"
new-migration name:
    docker compose run --rm api alembic revision --autogenerate -m "{{name}}"

# Revert migrations (steps=N, default 1)
migrate-down steps="1":
    docker compose run --rm api alembic downgrade -{{steps}}

# Show the current migration revision
migrate-current:
    docker compose run --rm api alembic current

# Show the full migration history
migrate-history:
    docker compose run --rm api alembic history

# ─── CLEAN ──────────────────────────────────────────────────────

# Stop the stack and drop its volumes + orphans
clean-volumes:
    docker compose down -v --remove-orphans

# ─── SEEDS ──────────────────────────────────────────────────────
# Run after `just backend migrate`. Order matters: users → roles.
# Seeded users share password 12345678x; canonical login [[ owner_email ]].

# Seed demo tenants/users, then synchronize default tenant roles
seed: seed-users seed-roles

# Seed tenants, users and tenant-user memberships
seed-users: _ensure-env
    docker compose run --rm api python scripts/seed_users.py

# Synchronize default roles for existing tenants
seed-roles: _ensure-env
    docker compose run --rm api python scripts/bootstrap_tenant_roles.py

# Requires the `admin` (Directus) service to have created its schema first.
# Idempotent (ON CONFLICT DO UPDATE); loads in the order from fixtures/admin/README.md.
# Load Directus admin metadata (collections, fields, …) into the directus_* tables
seed-admin:
    #!/usr/bin/env bash
    set -euo pipefail
    docker compose up -d postgres >/dev/null
    for f in directus_roles.sql directus_users.sql directus_collections.sql directus_fields.sql directus_flows.sql; do
        path="fixtures/admin/${f}"
        [ -f "${path}" ] || continue
        echo "→ ${f}"
        docker compose exec -T postgres psql -v ON_ERROR_STOP=1 -U postgres -d postgres < "${path}"
    done
    echo "✅ Directus admin metadata loaded"

# ─── MINIO ──────────────────────────────────────────────────────

# Create the bucket and make its tenants/ prefix publicly downloadable
minio-setup bucket="[[ project_slug ]]-dev":
    docker run --rm --network [[ project_slug ]]-backend_default --entrypoint /bin/sh minio/mc \
        -c "mc alias set local http://minio:9000 minioadmin minioadmin && mc mb -p 'local/{{bucket}}' && mc anonymous set download 'local/{{bucket}}/tenants'"

# Make the tenants/ prefix publicly downloadable on an existing bucket
minio-public bucket="[[ project_slug ]]-dev":
    docker run --rm --network [[ project_slug ]]-backend_default --entrypoint /bin/sh minio/mc \
        -c "mc alias set local http://minio:9000 minioadmin minioadmin && mc anonymous set download 'local/{{bucket}}/tenants'"
