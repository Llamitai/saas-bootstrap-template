<svg xmlns="http://www.w3.org/2000/svg" width="1080" height="1080" viewBox="0 0 1080 1080" role="img" aria-labelledby="title desc">
  <title id="title">[[ project_name ]] system architecture</title>
  <desc id="desc">Architecture diagram for the current [[ project_name ]] project: Browser, Next.js frontend and BFF routes, FastAPI backend, Postgres, Redis with SAQ workers, MinIO or S3 asset storage, Mailpit or SMTP email, Directus admin, and optional Astro docs.</desc>

  <defs>
    <style>
      .bg { fill: #f3f7f7; }
      .panel { fill: #ffffff; stroke: #d8e3e1; stroke-width: 1.4; }
      .panel-soft { fill: #f8fbfb; stroke: #d8e3e1; stroke-width: 1.2; }
      .service { fill: #ffffff; stroke: #cbd8d6; stroke-width: 1.2; }
      .accent { fill: #0f766e; }
      .accent-soft { fill: #e4f4f2; stroke: #9ccbc5; stroke-width: 1.2; }
      .muted { fill: #5f6f73; }
      .title { fill: #16333a; font: 700 28px Inter, ui-sans-serif, system-ui, sans-serif; }
      .subtitle { fill: #60727a; font: 400 13px Inter, ui-sans-serif, system-ui, sans-serif; }
      .label { fill: #16333a; font: 700 16px Inter, ui-sans-serif, system-ui, sans-serif; }
      .small { fill: #52666d; font: 500 12px Inter, ui-sans-serif, system-ui, sans-serif; }
      .mono { fill: #52666d; font: 500 11px "SFMono-Regular", Consolas, ui-monospace, monospace; }
      .chip { fill: #eef5f4; stroke: #d2dfdd; stroke-width: 1; }
      .chip-text { fill: #31515a; font: 600 11px Inter, ui-sans-serif, system-ui, sans-serif; }
      .arrow { fill: none; stroke: #60727a; stroke-width: 1.8; marker-end: url(#arrow); }
      .arrow-accent { fill: none; stroke: #0f766e; stroke-width: 2; marker-end: url(#arrow-accent); }
      .dash { stroke-dasharray: 6 5; }
    </style>

    <marker id="arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
      <path d="M 0 0 L 10 5 L 0 10 z" fill="#60727a" />
    </marker>
    <marker id="arrow-accent" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
      <path d="M 0 0 L 10 5 L 0 10 z" fill="#0f766e" />
    </marker>
  </defs>

  <rect class="bg" width="1080" height="680" />

  <text x="56" y="54" class="title">[[ project_name ]] Architecture</text>
  <text x="56" y="78" class="subtitle">Current core: auth, tenants, members, roles, profile, settings/avatar, superuser, messaging and Directus admin.</text>

  <rect x="56" y="112" width="196" height="118" rx="10" class="panel" />
  <circle cx="91" cy="151" r="18" class="accent-soft" />
  <path d="M82 151h18M91 142v18" stroke="#0f766e" stroke-width="2" stroke-linecap="round" />
  <text x="122" y="148" class="label">Browser</text>
  <text x="122" y="170" class="small">authenticated users</text>
  <text x="122" y="190" class="mono">cookies + same-origin API</text>

  <rect x="314" y="104" width="292" height="164" rx="12" class="panel" />
  <text x="338" y="137" class="label">Frontend: Next.js 16</text>
  <text x="338" y="159" class="small">React 19, App Router, Tailwind v4</text>
  <rect x="338" y="181" width="99" height="28" rx="14" class="chip" />
  <text x="387" y="199" text-anchor="middle" class="chip-text">protected app</text>
  <rect x="447" y="181" width="67" height="28" rx="14" class="chip" />
  <text x="480" y="199" text-anchor="middle" class="chip-text">public</text>
  <rect x="524" y="181" width="58" height="28" rx="14" class="chip" />
  <text x="553" y="199" text-anchor="middle" class="chip-text">i18n</text>
  <text x="338" y="232" class="mono">pages: login, register, reset, invitations</text>
  <text x="338" y="250" class="mono">app: members, roles, profile, settings</text>

  <rect x="314" y="312" width="292" height="156" rx="12" class="panel" />
  <text x="338" y="345" class="label">Next.js BFF routes</text>
  <text x="338" y="367" class="small">server-only access to backend config</text>
  <text x="338" y="393" class="mono">/api/auth/login</text>
  <text x="338" y="411" class="mono">/api/auth/logout</text>
  <text x="338" y="429" class="mono">/api/auth/refresh</text>
  <text x="338" y="447" class="mono">/api/auth/google, reset-password</text>

  <rect x="674" y="92" width="350" height="406" rx="14" class="panel" />
  <text x="700" y="128" class="label">Backend: FastAPI 8200</text>
  <text x="700" y="150" class="small">Clean Architecture + DDD modules</text>

  <rect x="700" y="177" width="300" height="62" rx="9" class="panel-soft" />
  <text x="720" y="199" class="small">Presentation routers</text>
  <text x="720" y="217" class="mono">common, auth, users, me</text>
  <text x="720" y="233" class="mono">tenants, invitations, tasks</text>

  <rect x="700" y="246" width="300" height="78" rx="9" class="panel-soft" />
  <text x="720" y="268" class="small">Application and domain</text>
  <text x="720" y="286" class="mono">auth, users, profile, tenants</text>
  <text x="720" y="304" class="mono">assets, admin, messaging, common</text>

  <rect x="700" y="341" width="300" height="56" rx="9" class="panel-soft" />
  <text x="720" y="363" class="small">Infrastructure</text>
  <text x="720" y="381" class="mono">SQLAlchemy repos, JWT, Redis, S3, SMTP</text>

  <rect x="700" y="414" width="300" height="56" rx="9" class="panel-soft" />
  <text x="720" y="436" class="small">Background commands</text>
  <text x="720" y="454" class="mono">SAQ worker: saq config.tasks.worker_settings</text>

  <text x="56" y="692" class="label">Runtime services</text>
  <text x="56" y="714" class="small">Local compose stack and replaceable external services.</text>

  <rect x="56" y="780" width="146" height="92" rx="10" class="service" />
  <text x="80" y="816" class="label">Postgres 17</text>
  <text x="80" y="840" class="small">tenant data</text>
  <text x="80" y="862" class="mono">port 5434</text>

  <rect x="226" y="780" width="132" height="92" rx="10" class="service" />
  <text x="250" y="816" class="label">Redis 7</text>
  <text x="250" y="840" class="small">tokens, rate limit</text>
  <text x="250" y="862" class="mono">SAQ queue</text>

  <rect x="382" y="780" width="140" height="92" rx="10" class="service" />
  <text x="406" y="816" class="label">MinIO / S3</text>
  <text x="406" y="840" class="small">avatars, assets</text>
  <text x="406" y="862" class="mono">ports 9000/9001</text>

  <rect x="546" y="780" width="132" height="92" rx="10" class="service" />
  <text x="570" y="816" class="label">Mailpit / SMTP</text>
  <text x="570" y="840" class="small">transactional email</text>
  <text x="570" y="862" class="mono">1027, 8027</text>

  <rect x="702" y="780" width="142" height="92" rx="10" class="service" />
  <text x="726" y="816" class="label">Directus Admin</text>
  <text x="726" y="840" class="small">internal console</text>
  <text x="726" y="862" class="mono">port 8055</text>

  <rect x="868" y="780" width="156" height="92" rx="10" class="service" />
  <text x="892" y="816" class="label">Astro Docs</text>
  <text x="892" y="840" class="small">technical docs</text>
  <text x="892" y="862" class="mono">optional port 4321</text>

  <path class="arrow-accent" d="M252 171 C284 171 282 171 314 171" />
  <text x="276" y="158" text-anchor="middle" class="mono">HTTPS</text>

  <path class="arrow-accent" d="M460 268 L460 312" />
  <text x="474" y="294" class="mono">BFF</text>

  <path class="arrow-accent" d="M606 390 C632 390 642 295 674 295" />
  <text x="635" y="345" class="mono">/v1</text>

  <path class="arrow" d="M760 498 C692 650 236 706 154 780" />
  <path class="arrow" d="M808 498 C754 646 372 706 292 780" />
  <path class="arrow" d="M856 498 C812 648 532 708 456 780" />
  <path class="arrow" d="M904 498 C874 650 686 710 614 780" />
  <path class="arrow" d="M922 498 C904 650 832 710 778 780" />
  <path class="arrow dash" d="M606 438 C730 560 868 650 946 780" />

  <rect x="56" y="970" width="968" height="1" fill="#d8e3e1" />
  <text x="56" y="1000" class="mono">Core runtime only: app, API, data stores, background jobs, assets, email, admin console and docs.</text>
</svg>
