import { Braces, Compass, Lightbulb, Rocket, Users } from "lucide-react";

<Callout title="En resumen">
  [[ project_name ]] es una base multi-tenant para productos B2B autenticados: entrega auth, tenants, miembros, invitaciones, roles, permisos, perfil, assets y consola interna para que el producto de negocio se construya encima.
</Callout>

## Qué incluye

<TypeTable
  type={{
    auth: {
      description: "Login, Google, refresh, logout, reset de contraseña y consulta de sesión.",
      type: "backend + BFF",
    },
    "usuarios y perfil": {
      description: "Registro, perfil propio, contraseña y tenants del usuario.",
      type: "módulos users, profile",
    },
    tenants: {
      description: "Onboarding, tenant activo, settings, avatar y borrado lógico.",
      type: "bounded context",
    },
    "miembros e invitaciones": {
      description: "Membresía, invitaciones por email, aceptación, cancelación y perfil del miembro.",
      type: "tenants",
    },
    "roles y permisos": {
      description: "Roles por tenant y chequeos de permiso (modelados; el enforcement está desactivado por defecto).",
      type: "autorización",
    },
    assets: {
      description: "Imágenes de tenant y miembro en almacenamiento S3 (RustFS en local).",
      type: "adapter de storage",
    },
    "messaging y jobs": {
      description: "Correo transaccional por SMTP y comandos diferidos sobre RabbitMQ.",
      type: "scaffolding",
    },
    Directus: {
      description: "Consola interna para metadatos operativos.",
      type: "admin",
    },
  }}
/>

