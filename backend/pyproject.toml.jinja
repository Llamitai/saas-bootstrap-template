[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[project]
name = "[[ project_slug ]]-api"
version = "0.1.0"
description = "[[ project_name ]] backend"
authors = [{name = "[[ project_name ]]", email = "[[ owner_email ]]"}]
readme = "README.md"
requires-python = ">=3.14,<3.15"
dependencies = [
    "fastapi>=0.139.2",
    "uvicorn>=0.51.0",
    "python-dotenv>=1.2.2",
    "pytz>=2026.2",
    "httpx>=0.28.1",
    "authlib>=1.7.2",
    "pydantic-settings>=2.15.0",
    "sentry-sdk[fastapi]>=2.35.0",
    "alembic>=1.18.5",
    "asyncpg>=0.31.0",
    "sqlalchemy>=2.0.51",
    "psycopg[binary]>=3.2.9",
    "bcrypt>=4.2.1",
    "pydantic[email]>=2.13.4",
    "python-slugify>=8.0.4",
    "python-multipart>=0.0.32",
    "saq>=0.12.0",
    "redis>=8.1.0",
    "aiosmtplib>=5.1.2",
    "jinja2>=3.1.6",
    "typer>=0.26.8",
    "pyyaml>=6.0.3",
    "uuid6>=2025.0.1",
    "boto3>=1.43.70",
    "nanoid>=2.0.0",
    "structlog>=26.1.0",
    "greenlet>=3.5.5",
]

[dependency-groups]
dev = [
    # Testing
    "pytest>=8.4.0",
    "pytest-asyncio>=1.4.0",
    "pytest-cov>=7.1.0",
    "pytest-sugar>=1.0.0",
    "pytest-clarity>=1.0.1",
    "expects>=0.9.0",
    "factory-boy>=3.3.3",
    "async-factory-boy>=1.0.1",
    "nest-asyncio>=1.6.0",
    "requests>=2.34.2",
    "faker>=40.35.0",
    # Code quality
    "ruff>=0.15.22",
    "ty>=0.0.70",
    "vulture>=2.16",
    "import-linter>=2.3",
    # Development tools
    "ipdb>=0.13.13",
    "ipython>=9.3.0",
    "debugpy>=1.8.20",
]

[tool.anyio]
test_mode = "asyncio"

[tool.importlinter]
root_package = "src"

# Clean Architecture direction inside every module: presentation may import
# infrastructure/application/domain, but never the other way around. Layers in
# parentheses are optional because not every module has all four (see AGENTS.md).
[% raw %][[[% endraw %]tool.importlinter.contracts[% raw %]]][% endraw %]
name = "Clean Architecture layers within each module"
type = "layers"
containers = [
    "src.admin",
    "src.assets",
    "src.auth",
    "src.common",
    "src.messaging",
    "src.profile",
    "src.tenants",
    "src.users",
]
layers = [
    "(presentation)",
    "(infrastructure)",
    "(application)",
    "(domain)",
]


[tool.uv]
package = false

[tool.pytest.ini_options]
asyncio_mode = "auto"
norecursedirs = "build dist _darcs {arch} *.egg node_modules */migrations/* */static/* docs *.egg-info .git __pycache__"
# -s >> no capture warnings
addopts = "--tb=short --maxfail=100 --strict-markers -s"
  testpaths = "tests"
  python_files = "tests.py test_*.py"
  python_classes = "*Tests"
  python_functions = "test_*"
  log_cli_date_format = "%Y-%m-%d %H:%M:%S"
  console_output_style = "progress"
  filterwarnings = [
    "ignore::DeprecationWarning",
    "ignore::PendingDeprecationWarning"
  ]
  markers = [
    "single: Run single test to debug it",
    "asyncio: mark test as async",
    "api: end-to-end API test (requires the running stack — use `just backend test api`)",
    "db: test requires the local PostgreSQL test database"
  ]
