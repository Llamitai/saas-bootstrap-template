#!/bin/bash
# Authenticate to Infisical, then run /commands <role> with the injected secrets.
set -o errexit
set -o nounset
set -o pipefail

export INFISICAL_DISABLE_UPDATE_CHECK=true
# Assigned separately from export so a failed login aborts the start.
# shellcheck disable=SC2086
INFISICAL_TOKEN=$(infisical login --method=universal-auth --client-id=$INFISICAL_MACHINE_CLIENT_ID --client-secret=$INFISICAL_MACHINE_CLIENT_SECRET --domain=$INFISICAL_API_URL --plain --silent)
export INFISICAL_TOKEN
# shellcheck disable=SC2086
exec infisical run \
    --token $INFISICAL_TOKEN \
    --projectId $PROJECT_ID \
    --env $INFISICAL_SECRET_ENV \
    --domain $INFISICAL_API_URL \
    -- /commands "$@"
