# -> GENERAL
STAGE=dev  # Options: dev, staging, production
ENVIRONMENT=development  # Options: development, staging, production
CORS_ORIGINS=http://localhost:3000,http://localhost:8200

# -> GOOGLE LOGIN
GOOGLE_CLIENT_ID=your-google-client-id-here
GOOGLE_CLIENT_SECRET=your-google-client-secret-here
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# -> JWT CONFIG
# openssl rand -hex 32 — auto-generated in dev when empty; required (>= 32 chars) in production
JWT_SECRET_KEY=
# Token lifetimes default to 15 minutes (access) / 7 days (refresh) in code.
# Keep them short: the frontend BFF auto-refreshes access tokens transparently.
# JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
# JWT_REFRESH_TOKEN_EXPIRE_MINUTES=10080  # 7 days (60 * 24 * 7)
JWT_ALGORITHM=HS256

# -> COMMON
# openssl rand -base64 32 | tr '+/' '-_' | tr -d '\n'
SECRET_KEY=

# -> DATABASES
POSTGRES_USER=postgres
POSTGRES_DB=postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_PASSWORD=postgres
REDIS_HOST=redis
REDIS_USER=
REDIS_PASSWORD=
REDIS_PORT=6379
REDIS_DB=0

# -> NOTIFICATIONS (Email Configuration)
# Defaults target the bundled Mailpit from docker-compose.yml; sent mail is
# viewable at http://localhost:8027. For real SMTP set host/port/TLS/credentials.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_TLS=false
SMTP_USERNAME=mailpit-accepts-any-user
SMTP_PASSWORD=mailpit-accepts-any-password
DEFAULT_FROM_EMAIL=noreply@example.com

# -> STORAGE (S3-compatible; defaults target the bundled MinIO from docker-compose.yml)
# Create the dev bucket first with: just backend minio-setup
# For real AWS S3: clear AWS_S3_ENDPOINT_URL and set your IAM credentials, bucket, and region.
AWS_S3_ENDPOINT_URL=http://minio:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_S3_REGION_NAME=us-east-1
AWS_STORAGE_BUCKET_NAME=[[ project_slug ]]-dev
AWS_S3_PUBLIC_URL=http://localhost:9000/[[ project_slug ]]-dev  # Browser-reachable base URL for stored assets (minio-setup bucket)
# Optional: CDN domain in front of the bucket (real S3 only)
AWS_CLOUDFRONT_DOMAIN=

# -> AEGORA AWS BATCH
# In production these values come from Infisical. Keep Aegora credentials
# separate from AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY used by asset storage.
AEGORA_AWS_ACCESS_KEY_ID=
AEGORA_AWS_SECRET_ACCESS_KEY=
AEGORA_AWS_REGION=us-east-1
AEGORA_BATCH_JOB_QUEUE=
AEGORA_BATCH_JOB_DEFINITION=
AEGORA_BATCH_EVENT_QUEUE_URL=

# -> MONITORING
SENTRY_DSN=
SENTRY_ENVIRONMENT=dev  # Options: dev, staging, production
SENTRY_TRACES_SAMPLE_RATE=0.1  # 10% of transactions
SENTRY_PROFILES_SAMPLE_RATE=0.1  # 10% of transactions
SENTRY_SEND_DEFAULT_PII=false  # GDPR compliance

# -> FRONTEND
FRONTEND_HOST=http://localhost:3000

# -> ADMIN
# Generate ONE key (openssl rand -hex 32) and set it here AND as BACKEND_API_KEY
# in frontend/.env. Directus reads it from this file via docker compose. If left
# empty, dev generates a NEW random key on every boot, which the other services
# can never match.
ADMIN_API_KEY=
ADMIN_LOGO_URL=https://preview.tabler.io/static/logo-white.svg
ADMIN_LOGIN_LOGO_URL=https://preview.tabler.io/static/logo.svg

# -> DIRECTUS (internal admin console, see docker-compose.yml)
# openssl rand -base64 32 — dev fallback used when empty
DIRECTUS_SECRET=
# Dev fallback used when empty
DIRECTUS_ADMIN_PASSWORD=

# -> GOOGLE APIs
GOOGLE_CERTS_URL=https://www.googleapis.com/oauth2/v3/certs
