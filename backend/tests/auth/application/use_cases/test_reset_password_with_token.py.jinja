from unittest.mock import AsyncMock, create_autospec
from uuid import uuid4

import pytest
from expects import equal, expect

from src.auth.application.use_cases.password_reset.resetter import PasswordResetter
from src.common.domain.enums.jwt import JwtTokenScope
from src.common.domain.exceptions.common import InvalidOrExpiredTokenError
from src.common.domain.services.token_builder import JwtTokenClaims
from src.common.domain.services.token_store import TokenStore
from src.users.domain.repositories.user import UserRepository


@pytest.fixture
def user_repository():
    return create_autospec(spec=UserRepository, spec_set=True, instance=True)


@pytest.fixture
def token_store():
    store = create_autospec(spec=TokenStore, spec_set=True, instance=True)
    store.is_blacklisted.return_value = False
    return store


def _valid_claims(user_id):
    return JwtTokenClaims(
        iss="[[ project_slug ]]",
        sub=str(user_id),
        iat=1700000000,
        exp=1700003600,
        jti="test-jti",
        ns="JWT",
        scope=JwtTokenScope.PASSWORD_RESET,
    )


async def test_execute__valid_token_sets_password(user_repository, token_service, token_store):
    user_id = uuid4()
    token_service.get_claims = AsyncMock(return_value=_valid_claims(user_id))
    user_repository.set_password.return_value = True

    use_case = PasswordResetter(
        token="valid.token",
        new_password="newSecret123",
        user_repository=user_repository,
        token_service=token_service,
        token_store=token_store,
    )

    await use_case.execute()

    user_repository.set_password.assert_called_once()
    call_kwargs = user_repository.set_password.call_args.kwargs
    expect(call_kwargs["user_id"]).to(equal(user_id))
    expect(call_kwargs["new_password"]).to(equal("newSecret123"))
    token_service.get_claims.assert_called_once_with(
        "valid.token",
        scope=JwtTokenScope.PASSWORD_RESET,
    )


async def test_execute__invalid_token_raises(user_repository, token_service, token_store):
    token_service.get_claims = AsyncMock(return_value=None)

    use_case = PasswordResetter(
        token="bad.token",
        new_password="newSecret123",
        user_repository=user_repository,
        token_service=token_service,
        token_store=token_store,
    )

    with pytest.raises(InvalidOrExpiredTokenError):
        await use_case.execute()

    user_repository.set_password.assert_not_called()


async def test_execute__malformed_sub_raises(user_repository, token_service, token_store):
    bogus = JwtTokenClaims(
        iss="[[ project_slug ]]",
        sub="not-a-uuid",
        iat=1700000000,
        exp=1700003600,
        jti="t",
        ns="JWT",
        scope=JwtTokenScope.PASSWORD_RESET,
    )
    token_service.get_claims = AsyncMock(return_value=bogus)

    use_case = PasswordResetter(
        token="t",
        new_password="newSecret123",
        user_repository=user_repository,
        token_service=token_service,
        token_store=token_store,
    )

    with pytest.raises(InvalidOrExpiredTokenError):
        await use_case.execute()


async def test_execute__user_disappeared_raises(user_repository, token_service, token_store):
    """Defensive: if the user was removed between issuing and consuming
    the token, set_password returns False — we surface it as
    invalid/expired rather than crashing."""
    user_id = uuid4()
    token_service.get_claims = AsyncMock(return_value=_valid_claims(user_id))
    user_repository.set_password.return_value = False

    use_case = PasswordResetter(
        token="t",
        new_password="newSecret123",
        user_repository=user_repository,
        token_service=token_service,
        token_store=token_store,
    )

    with pytest.raises(InvalidOrExpiredTokenError):
        await use_case.execute()


async def test_execute__successful_reset_burns_token(user_repository, token_service, token_store):
    """After a successful reset the token's jti is blacklisted for its
    remaining lifetime so the same token cannot be replayed."""
    user_id = uuid4()
    token_service.get_claims = AsyncMock(return_value=_valid_claims(user_id))
    user_repository.set_password.return_value = True

    use_case = PasswordResetter(
        token="valid.token",
        new_password="newSecret123",
        user_repository=user_repository,
        token_service=token_service,
        token_store=token_store,
    )

    await use_case.execute()

    token_store.is_blacklisted.assert_called_once_with(jti="test-jti", namespace="JWT")
    token_store.blacklist_token_jti.assert_called_once()
    call_kwargs = token_store.blacklist_token_jti.call_args.kwargs
    expect(call_kwargs["jti"]).to(equal("test-jti"))
    expect(call_kwargs["namespace"]).to(equal("JWT"))


async def test_execute__replayed_token_raises(user_repository, token_service, token_store):
    """A token whose jti is already blacklisted (i.e. it was consumed by a
    previous reset) is rejected even though the JWT itself is still valid."""
    user_id = uuid4()
    token_service.get_claims = AsyncMock(return_value=_valid_claims(user_id))
    token_store.is_blacklisted.return_value = True

    use_case = PasswordResetter(
        token="valid.token",
        new_password="newSecret123",
        user_repository=user_repository,
        token_service=token_service,
        token_store=token_store,
    )

    with pytest.raises(InvalidOrExpiredTokenError):
        await use_case.execute()

    user_repository.set_password.assert_not_called()
    token_store.blacklist_token_jti.assert_not_called()


async def test_execute__failed_reset_does_not_burn_token(user_repository, token_service, token_store):
    """If the password update fails, the token is NOT blacklisted so the
    user can retry with the same (still valid) reset link."""
    user_id = uuid4()
    token_service.get_claims = AsyncMock(return_value=_valid_claims(user_id))
    user_repository.set_password.return_value = False

    use_case = PasswordResetter(
        token="valid.token",
        new_password="newSecret123",
        user_repository=user_repository,
        token_service=token_service,
        token_store=token_store,
    )

    with pytest.raises(InvalidOrExpiredTokenError):
        await use_case.execute()

    token_store.blacklist_token_jti.assert_not_called()
