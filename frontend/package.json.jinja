{
  "name": "[[ project_slug ]]-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "NODE_OPTIONS='--no-deprecation' next dev",
    "build": "next build",
    "start": "NODE_OPTIONS='--no-deprecation' next start",
    "lint": "biome lint .",
    "lint:boundaries": "node scripts/check-import-boundaries.mjs",
    "lint:fix": "biome lint --write .",
    "format": "biome format .",
    "format:write": "biome format --write .",
    "format:check": "biome format .",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test --pass-with-no-tests",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "gen:feature": "node scripts/gen-feature.mjs",
    "verify": "pnpm type-check && pnpm check && pnpm test && pnpm check:architecture && pnpm build",
    "check": "biome check .",
    "check:architecture": "pnpm lint:boundaries",
    "check:fix": "biome check --write .",
    "ci": "biome ci .",
    "postinstall": "node -e \"process.exit(0)\""
  },
