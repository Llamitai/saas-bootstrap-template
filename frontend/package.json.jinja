    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.71.1",
    "react-icons": "^5.5.0",
    "react-syntax-highlighter": "^16.1.1",
    "tailwind-merge": "^3.4.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
