# Backend API Configuration
NEXT_PUBLIC_BACKEND_API_HOST=http://localhost:8200
BACKEND_API_HOST=http://localhost:8200

# Admin API key (server-side only)
BACKEND_API_KEY=your-api-key-here

# Header set by a trusted edge with the real client IP (e.g. cf-connecting-ip,
# x-real-ip). Empty: the last X-Forwarded-For hop. Sent to the backend as
# X-Client-IP for per-client rate limits.
TRUSTED_CLIENT_IP_HEADER=

# App Version
NEXT_PUBLIC_VERSION=1.0.0

# App URL (for metadata and Open Graph images)
NEXT_PUBLIC_APP_URL=https://example.com

# Node Environment
NODE_ENV=development

SENTRY_DSN=

# Google OAuth (login) — client ID del OAuth client; el secret vive solo en el backend
GOOGLE_CLIENT_ID=
# OJO: NEXT_PUBLIC_APP_URL sin slash final; NEXT_PUBLIC_APP_URL + /api/auth/google/callback debe ser EXACTAMENTE el GOOGLE_REDIRECT_URI del backend
