# Operator inputs for the first production deploy.
#
#   cp <skill-dir>/assets/env.deploy.template .env.deploy
#
# This file holds live credentials. It must never be committed.
# Confirm `.env.deploy` is matched by .gitignore before filling it in:
#
#   git check-ignore -v .env.deploy
#
# The deploy-mvp scripts read it on your machine only. Where values go:
#   * keys that also appear in backend/.env.example or frontend/.env.example
#     (the "Application settings" block below) are seeded into Infisical by
#     phase 2;
#   * the GitHub and stack blocks are copied into GitHub environments (phase 3)
#     and the Portainer stack env (phase 4);
#   * everything else (Postgres superuser, Portainer token, clone PAT) stays here.
#
# Generated values land in `.env.deploy.generated` (phases 1-2), never here.
# github_setup.sh reads ONE file, so phase 3 merges both into `.env.deploy.ci`.

# ─── Project identity ───────────────────────────────────────────────
# Lowercase, alphanumeric + hyphens. Used to derive the Postgres role and
# database, and the suggested stack names below.
PROJECT_SLUG=

# owner/repo on GitHub, e.g. acme-inc/acme-app
GITHUB_REPOSITORY=

# Public origins the deployed app will serve on.
PUBLIC_APP_URL=https://app.example.com
PUBLIC_API_URL=https://api.example.com

# ─── PostgreSQL superuser ───────────────────────────────────────────
# Used only during phase 1 to create the project role and databases.
# Never written anywhere; not needed after provisioning.
PGHOST=
PGPORT=5432
PGUSER=postgres
PGPASSWORD=
# Database to connect to while creating the new ones (must already exist).
PGDATABASE=postgres
# Optional: require TLS to the Postgres server. Recommended for remote servers.
PGSSLMODE=prefer

# Host:port the *containers* use to reach Postgres. Often differs from PGHOST
# (which is how *you* reach it). If Postgres runs on the Docker host, this is
# usually the host's LAN address or a service name on shared-network.
APP_POSTGRES_HOST=
APP_POSTGRES_PORT=5432

# ─── Application settings seeded into Infisical (phase 2) ───────────
# The production compose files ship no Valkey service: point these at a Valkey
# (Redis protocol) the backend container can reach. Backend settings refuse to
# start in production without REDIS_PASSWORD, and the production URL embeds
# REDIS_USER (use `default` for a Valkey that only sets requirepass). Configure
# it like backend/docker/valkey/valkey.conf (maxmemory-policy allkeys-lru,
# appendonly yes): the session allowlist fails closed, so eviction only forces a
# re-login, and AOF keeps sessions across restarts.
REDIS_HOST=
REDIS_USER=default
REDIS_PASSWORD=
# The production compose files ship no RabbitMQ either: the API and the worker
# connect at startup and declare their queues. Use a dedicated user and vhost;
# settings reject the 'app'/'guest' defaults in production. Broker stability
# settings to mirror: backend/docker/rabbitmq/rabbitmq.conf.
RABBITMQ_HOST=
RABBITMQ_USER=
RABBITMQ_PASSWORD=
RABBITMQ_VHOST=/
# Add any other backend/frontend .env.example key the phase 2 plan reports as
# MISSING (GOOGLE_CLIENT_ID, SMTP_HOST, AWS_* ...) here.

# ─── Infisical ──────────────────────────────────────────────────────
# Self-hosted base URL (no trailing slash), or https://app.infisical.com
INFISICAL_API_URL=
# Machine identity with universal auth, granted access to both projects.
INFISICAL_MACHINE_CLIENT_ID=
INFISICAL_MACHINE_CLIENT_SECRET=
# Environment slug to seed. Match what the stack passes as INFISICAL_SECRET_ENV.
INFISICAL_SECRET_ENV=prod
# Project ids. Create them with `infisical_seed.py create-project` and record
# the ids here; every seed passes one explicitly with --project-id.
BACKEND_PROJECT_ID=
FRONTEND_PROJECT_ID=

# ─── Portainer ──────────────────────────────────────────────────────
# Base URL of the Portainer instance (no trailing slash, no /api suffix).
PORTAINER_URL=
# API access token from User settings -> Access tokens.
PORTAINER_TOKEN=
# Environment (endpoint) id to deploy into. `preflight.py` lists the options.
PORTAINER_ENDPOINT_ID=
# Set to 1 if the GitHub repository is private (Portainer then needs to
# authenticate to clone it; supply a PAT with `repo` scope below).
PORTAINER_REPO_PRIVATE=0
GITHUB_CLONE_USERNAME=
GITHUB_CLONE_TOKEN=

# ─── GitHub Actions deploy targets (phase 3, github_setup.sh) ───────
# Image names. They MUST equal the `image:` of the matching
# docker-compose.prod.yml (without the tag), or CI pushes an image the stack
# never pulls. Lowercase only.
BACKEND_REPOSITORY_URI=ghcr.io/<owner>/<project>-api-prod
FRONTEND_REPOSITORY_URI=ghcr.io/<owner>/<project>-web-prod
# Portainer stack names the deploy step creates or updates.
BACKEND_DEPLOYMENT_SERVICE=
FRONTEND_DEPLOYMENT_SERVICE=
BACKEND_DEPLOYMENT_COMPOSE_FILE=backend/docker-compose.prod.yml
FRONTEND_DEPLOYMENT_COMPOSE_FILE=frontend/docker-compose.prod.yml
# Optional: Cloudflare Access service token for Portainer. No workflow passes
# these yet; see references/env-vars.md § Two names that need a decision.
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=

# ─── Directus admin console (backend stack only) ────────────────────
# These reach the directus-admin service through the Portainer stack env.
# Leave ADMIN_DB_* blank: phase 1 writes them to .env.deploy.generated.
# ADMIN_SECRET / ADMIN_PASSWORD are NOT generated by any script; phase 2 of
# SKILL.md shows how to write them to .env.deploy.generated without printing.
ADMIN_EMAIL=
ADMIN_PUBLIC_URL=
ADMIN_DB_HOST=
ADMIN_DB_DATABASE=
ADMIN_DB_USER=
ADMIN_DB_PASSWORD=
ADMIN_SECRET=
ADMIN_PASSWORD=
