{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://llamit.ai/schemas/resolve-dependabot-prs/candidate-v1.schema.json",
  "title": "resolve-dependabot-prs candidate v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "repository",
    "base",
    "groupKey",
    "sources",
    "manifestPaths",
    "versions",
    "additionalDependencies",
    "observedAggregateImpact",
    "effectiveImpact",
    "impactRationale",
    "decision",
    "closureReason",
    "parentPlanDigest",
    "stabilityEvidence",
    "closureEvidence",
    "mode",
    "targetPrNumber",
    "commitSha",
    "treeSha",
    "validation"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "repository": {
      "$ref": "#/$defs/repository"
    },
    "base": {
      "$ref": "#/$defs/base"
    },
    "groupKey": {
      "$ref": "#/$defs/sha256"
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "manifestPaths": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/path"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "versions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/version"
      },
      "minItems": 1
    },
    "additionalDependencies": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/additionalDependency"
      },
      "uniqueItems": true
    },
    "observedAggregateImpact": {
      "$ref": "#/$defs/observedImpact"
    },
    "effectiveImpact": {
      "$ref": "#/$defs/effectiveImpact"
    },
    "impactRationale": {
      "type": "string",
      "minLength": 1
    },
    "decision": {
      "enum": [
        "update",
        "close-nonapplicable",
        "close-declined-major"
      ]
    },
    "closureReason": {
      "oneOf": [
        {
          "enum": [
            "prerelease",
            "withdrawn",
            "duplicate-merged",
            "already-in-base",
            "unsupported-platform",
            "superseded-merged",
            "major-declined"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "parentPlanDigest": {
      "oneOf": [
        {
          "$ref": "#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "stabilityEvidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/releaseEvidence"
      },
      "uniqueItems": true
    },
    "closureEvidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/closureEvidence"
      },
      "uniqueItems": true
    },
    "mode": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "direct",
        "replacement",
        null
      ]
    },
    "targetPrNumber": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "commitSha": {
      "oneOf": [
        {
          "$ref": "#/$defs/sha40"
        },
        {
          "type": "null"
        }
      ]
    },
    "treeSha": {
      "oneOf": [
        {
          "$ref": "#/$defs/sha40"
        },
        {
          "type": "null"
        }
      ]
    },
    "validation": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/validation"
      },
      "uniqueItems": true
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "sources"
        ],
        "properties": {
          "sources": {
            "minItems": 2
          }
        }
      },
      "then": {
        "properties": {
          "stabilityEvidence": {
            "items": {
              "allOf": [
                {
                  "$ref": "#/$defs/releaseEvidence"
                },
                {
                  "properties": {
                    "summary": {
                      "oneOf": [
                        {
                          "pattern": "^breaking=(?:none|not-applicable); adaptation=(?:not-required|.+)$"
                        },
                        {
                          "pattern": "^breaking=applicable; adaptation=(?!not-required$).+$"
                        }
                      ]
                    }
                  }
                }
              ]
            }
          }
        }
      }
    }
  ],
  "oneOf": [
    {
      "title": "direct update",
      "properties": {
        "sources": {
          "maxItems": 1
        },
        "decision": {
          "const": "update"
        },
        "closureReason": {
          "type": "null"
        },
        "parentPlanDigest": {
          "type": "null"
        },
        "stabilityEvidence": {
          "minItems": 1
        },
        "closureEvidence": {
          "maxItems": 0
        },
        "mode": {
          "const": "direct"
        },
        "targetPrNumber": {
          "type": "integer",
          "minimum": 1
        },
        "commitSha": {
          "$ref": "#/$defs/sha40"
        },
        "treeSha": {
          "$ref": "#/$defs/sha40"
        },
        "validation": {
          "minItems": 1
        }
      }
    },
    {
      "title": "replacement update",
      "properties": {
        "decision": {
          "const": "update"
        },
        "closureReason": {
          "type": "null"
        },
        "parentPlanDigest": {
          "type": "null"
        },
        "stabilityEvidence": {
          "minItems": 1
        },
        "closureEvidence": {
          "maxItems": 0
        },
        "mode": {
          "const": "replacement"
        },
        "targetPrNumber": {
          "type": "null"
        },
        "commitSha": {
          "$ref": "#/$defs/sha40"
        },
        "treeSha": {
          "$ref": "#/$defs/sha40"
        },
        "validation": {
          "minItems": 1
        }
      }
    },
    {
      "title": "autonomous prerelease close",
      "properties": {
        "decision": {
          "const": "close-nonapplicable"
        },
        "closureReason": {
          "const": "prerelease"
        },
        "parentPlanDigest": {
          "type": "null"
        },
        "stabilityEvidence": {
          "maxItems": 0
        },
        "closureEvidence": {
          "minItems": 1,
          "items": {
            "allOf": [
              {
                "$ref": "#/$defs/closureEvidence"
              },
              {
                "properties": {
                  "predicate": {
                    "const": "version-prerelease"
                  }
                }
              }
            ]
          }
        },
        "mode": {
          "type": "null"
        },
        "targetPrNumber": {
          "type": "null"
        },
        "commitSha": {
          "type": "null"
        },
        "treeSha": {
          "type": "null"
        },
        "validation": {
          "maxItems": 0
        }
      }
    },
    {
      "title": "autonomous merged replacement close",
      "properties": {
        "decision": {
          "const": "close-nonapplicable"
        },
        "closureReason": {
          "enum": [
            "duplicate-merged",
            "superseded-merged"
          ]
        },
        "parentPlanDigest": {
          "type": "null"
        },
        "stabilityEvidence": {
          "maxItems": 0
        },
        "closureEvidence": {
          "minItems": 1,
          "items": {
            "allOf": [
              {
                "$ref": "#/$defs/closureEvidence"
              },
              {
                "properties": {
                  "predicate": {
                    "const": "replacement-merged"
                  }
                }
              }
            ]
          }
        },
        "mode": {
          "type": "null"
        },
        "targetPrNumber": {
          "type": "null"
        },
        "commitSha": {
          "type": "null"
        },
        "treeSha": {
          "type": "null"
        },
        "validation": {
          "maxItems": 0
        }
      }
    },
    {
      "title": "human-reviewed close",
      "properties": {
        "decision": {
          "const": "close-nonapplicable"
        },
        "closureReason": {
          "enum": [
            "withdrawn",
            "already-in-base",
            "unsupported-platform"
          ]
        },
        "parentPlanDigest": {
          "type": "null"
        },
        "stabilityEvidence": {
          "maxItems": 0
        },
        "closureEvidence": {
          "minItems": 1,
          "items": {
            "allOf": [
              {
                "$ref": "#/$defs/closureEvidence"
              },
              {
                "properties": {
                  "predicate": {
                    "const": "human-reviewed"
                  }
                }
              }
            ]
          }
        },
        "mode": {
          "type": "null"
        },
        "targetPrNumber": {
          "type": "null"
        },
        "commitSha": {
          "type": "null"
        },
        "treeSha": {
          "type": "null"
        },
        "validation": {
          "maxItems": 0
        }
      }
    },
    {
      "title": "declined major close",
      "properties": {
        "decision": {
          "const": "close-declined-major"
        },
        "closureReason": {
          "const": "major-declined"
        },
        "parentPlanDigest": {
          "$ref": "#/$defs/sha256"
        },
        "stabilityEvidence": {
          "maxItems": 0
        },
        "closureEvidence": {
          "minItems": 1,
          "items": {
            "allOf": [
              {
                "$ref": "#/$defs/closureEvidence"
              },
              {
                "properties": {
                  "predicate": {
                    "const": "user-decision"
                  }
                }
              }
            ]
          }
        },
        "mode": {
          "type": "null"
        },
        "targetPrNumber": {
          "type": "null"
        },
        "commitSha": {
          "type": "null"
        },
        "treeSha": {
          "type": "null"
        },
        "validation": {
          "maxItems": 0
        }
      }
    }
  ],
  "$defs": {
    "sha40": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "rfc3339Utc": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]+)?Z$"
    },
    "nameWithOwner": {
      "type": "string",
      "pattern": "^[^/\\s]+/[^/\\s]+$"
    },
    "path": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*//)(?:[^/]+)(?:/[^/]+)*$"
    },
    "observedImpact": {
      "enum": [
        "patch",
        "minor",
        "major",
        "non-semver",
        "unknown"
      ]
    },
    "effectiveImpact": {
      "enum": [
        "patch",
        "minor",
        "major"
      ]
    },
    "ecosystem": {
      "enum": [
        "npm",
        "uv",
        "docker",
        "github-actions",
        "unknown"
      ]
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "host",
        "nameWithOwner",
        "remote",
        "root",
        "defaultBranch",
        "defaultBranchSha",
        "actorLogin"
      ],
      "properties": {
        "host": {
          "type": "string",
          "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9.-]*[A-Za-z0-9])?$"
        },
        "nameWithOwner": {
          "$ref": "#/$defs/nameWithOwner"
        },
        "remote": {
          "const": "origin"
        },
        "root": {
          "type": "string",
          "pattern": "^/(?:[^/]+)(?:/[^/]+)*$"
        },
        "defaultBranch": {
          "type": "string",
          "minLength": 1
        },
        "defaultBranchSha": {
          "$ref": "#/$defs/sha40"
        },
        "actorLogin": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "base": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repo",
        "ref",
        "sha"
      ],
      "properties": {
        "repo": {
          "$ref": "#/$defs/nameWithOwner"
        },
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "sha": {
          "$ref": "#/$defs/sha40"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "number",
        "headSha"
      ],
      "properties": {
        "number": {
          "type": "integer",
          "minimum": 1
        },
        "headSha": {
          "$ref": "#/$defs/sha40"
        }
      }
    },
    "version": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "ecosystem",
        "from",
        "to",
        "impact",
        "prerelease"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "ecosystem": {
          "$ref": "#/$defs/ecosystem"
        },
        "from": {
          "type": [
            "string",
            "null"
          ]
        },
        "to": {
          "type": "string",
          "minLength": 1
        },
        "impact": {
          "$ref": "#/$defs/observedImpact"
        },
        "prerelease": {
          "type": [
            "boolean",
            "null"
          ]
        }
      }
    },
    "additionalDependency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "ecosystem",
        "reason",
        "evidenceUrl"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "ecosystem": {
          "$ref": "#/$defs/ecosystem"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "evidenceUrl": {
          "type": "string",
          "format": "uri",
          "minLength": 1
        }
      }
    },
    "releaseEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "subject",
        "url",
        "summary",
        "contentSha256"
      ],
      "properties": {
        "kind": {
          "enum": [
            "registry",
            "release",
            "changelog",
            "compatibility"
          ]
        },
        "subject": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "contentSha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "closureEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceNumber",
        "predicate",
        "subject",
        "observed",
        "url",
        "contentSha256",
        "replacementPrNumber",
        "replacementMergeSha"
      ],
      "properties": {
        "sourceNumber": {
          "type": "integer",
          "minimum": 1
        },
        "predicate": {
          "enum": [
            "version-prerelease",
            "replacement-merged",
            "human-reviewed",
            "user-decision"
          ]
        },
        "subject": {
          "type": "string",
          "minLength": 1
        },
        "observed": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "contentSha256": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "replacementPrNumber": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "replacementMergeSha": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha40"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "oneOf": [
        {
          "properties": {
            "predicate": {
              "const": "version-prerelease"
            },
            "replacementPrNumber": {
              "type": "null"
            },
            "replacementMergeSha": {
              "type": "null"
            }
          }
        },
        {
          "properties": {
            "predicate": {
              "const": "replacement-merged"
            },
            "url": {
              "type": "string",
              "format": "uri",
              "minLength": 1
            },
            "replacementPrNumber": {
              "type": "integer",
              "minimum": 1
            },
            "replacementMergeSha": {
              "$ref": "#/$defs/sha40"
            }
          }
        },
        {
          "properties": {
            "predicate": {
              "const": "human-reviewed"
            },
            "url": {
              "type": "string",
              "format": "uri",
              "minLength": 1
            },
            "contentSha256": {
              "$ref": "#/$defs/sha256"
            },
            "replacementPrNumber": {
              "type": "null"
            },
            "replacementMergeSha": {
              "type": "null"
            }
          }
        },
        {
          "properties": {
            "predicate": {
              "const": "user-decision"
            },
            "url": {
              "type": "null"
            },
            "contentSha256": {
              "type": "null"
            },
            "replacementPrNumber": {
              "type": "null"
            },
            "replacementMergeSha": {
              "type": "null"
            }
          }
        }
      ]
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command",
        "exitCode",
        "treeSha",
        "finishedAt"
      ],
      "properties": {
        "command": {
          "type": "string",
          "minLength": 1
        },
        "exitCode": {
          "const": 0
        },
        "treeSha": {
          "$ref": "#/$defs/sha40"
        },
        "finishedAt": {
          "$ref": "#/$defs/rfc3339Utc"
        }
      }
    }
  }
}
